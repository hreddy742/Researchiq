# Ollama — local or Fly.io deployment
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# PostgreSQL — local or Railway
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/researchiq

# SEC EDGAR — identify your app (required by SEC ToS)
SEC_USER_AGENT=ResearchIQ yourname@email.com

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Optional tuning
MAX_NEWS_HEADLINES=10
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
